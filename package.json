{
  "name": "cultural-influence-frontend",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "ЛР6 — React-интерфейс отрывков произведений с Redux Toolkit и REST API",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate-api": "node scripts/generate-artwork-api.mjs",
    "generate-api:saved": "node scripts/generate-artwork-api.mjs --saved",
    "test": "node --test tests/artwork-state.test.mjs",
    "test:integration": "node tests/artwork-integration.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.8",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "swagger-typescript-api": "^13.12.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
